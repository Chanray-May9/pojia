# 依赖（本项目零 npm 依赖，此行为兜底）
node_modules/

# 本地数据库与运行数据（后端 local-server.mjs 默认写入 data/local.db）
data/

# 前端构建产物（由 node frontend/build.mjs 生成，不入库）
frontend/dist/

# QA 临时产物
_qa/

# 截图/视觉回归产物
_shots/

# Wrangler 本地状态与缓存（本地 D1 模拟、构建缓存等）
.wrangler/
**/.wrangler/

# SQLite 数据库与 WAL/SHM 副产物
*.db
*.db-*
*.sqlite
*.sqlite-*

# 日志
*.log

# 操作系统/编辑器杂项
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# 部署自检临时产物
deploy/_qa/

